rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerifiedEmail() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return isVerifiedEmail() && (
        request.auth.token.email == 'antonov.oleg.1987@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Wine Validation
    function isValidWine(data) {
      return data.keys().hasAll(['name', 'type', 'year', 'grapes', 'desc', 'price', 'imageUrl', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && data.year is string && data.year.size() > 0 && data.year.size() <= 50
        && data.grapes is string && data.grapes.size() > 0 && data.grapes.size() <= 200
        && data.desc is string && data.desc.size() > 0 && data.desc.size() <= 5000
        && data.price is string && data.price.size() > 0 && data.price.size() <= 100
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // News Validation
    function isValidNews(data) {
      return data.keys().hasAll(['title', 'date', 'preview', 'content', 'image', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.date is string && data.date.size() > 0 && data.date.size() <= 50
        && data.preview is string && data.preview.size() > 0 && data.preview.size() <= 1000
        && data.content is string && data.content.size() > 0 && data.content.size() <= 20000
        && data.image is string && data.image.size() > 0 && data.image.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /wines/{wineId} {
      allow read: if true;
      allow create: if isAdmin()
                    && isValidId(wineId)
                    && isValidWine(incoming())
                    && incoming().keys().size() == 9
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;

      allow update: if isAdmin()
                    && isValidId(wineId)
                    && isValidWine(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'name', 'type', 'year', 'grapes', 'desc', 'price', 'imageUrl', 'updatedAt'
                    ]);

      allow delete: if isAdmin() && isValidId(wineId);
    }

    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin()
                    && isValidId(newsId)
                    && isValidNews(incoming())
                    && incoming().keys().size() == 7
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;

      allow update: if isAdmin()
                    && isValidId(newsId)
                    && isValidNews(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                      'title', 'date', 'preview', 'content', 'image', 'updatedAt'
                    ]);

      allow delete: if isAdmin() && isValidId(newsId);
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
